+/// Research harness (exp/g7-rtlf): one G7 measurement with a matched preamble.
+///
+/// Both classes run exactly this code before the clock starts: clone the
+/// fixture's inputs, run one untimed admission and reduction on that clone and
+/// drop it, then clone again into the black-boxed tuple that is timed. Every
+/// timed call therefore follows the same allocation sizes, the same copies and
+/// a warm-up on its own data, whichever fixture it is and whichever position
+/// it takes in the pair (ePrint 2026/2744, matched control).
+///
+/// `inject_ns` adds a known busy-wait inside the timed interval, for the
+/// positive control. It is zero except for the arm named by
+/// `STAGE2C_INJECT_INDEX`.
+fn time_reduction_matched<const W: usize, const D: usize>(
+    case: &Fixture<W>,
+    bounds: &Bounds<W, D>,
+    schedule: Schedule,
+    inject_ns: u128,
+) -> u128 {
+    let warm = black_box((case.t.clone(), case.u.clone(), case.v.clone()));
+    let (norm, u, v) = warm;
+    drop(black_box(
+        Basis::from_intersection(&norm, u, v, case.class, bounds).reduce(schedule),
+    ));
+    drop(norm);
+    let input = black_box((case.t.clone(), case.u.clone(), case.v.clone()));
+    let started = Instant::now();
+    let (norm, u, v) = input;
+    drop(black_box(
+        Basis::from_intersection(&norm, u, v, case.class, bounds).reduce(schedule),
+    ));
+    drop(norm);
+    if inject_ns > 0 {
+        let spin = Instant::now();
+        while spin.elapsed().as_nanos() < inject_ns {
+            std::hint::spin_loop();
+        }
+    }
+    started.elapsed().as_nanos()
+}
+
+/// G7 contrasts with `time_reduction_matched`. Index `cases.len()` is the
+/// reference row again (the null arm). Rows have the `timing` layout under the
+/// tag `matched`:
+/// `matched,set,class,schedule,index,repeat,reference_first,ref_ns,other_ns`.
+/// `STAGE2C_INJECT_NS` and `STAGE2C_INJECT_INDEX` add a delay to the other
+/// side of one arm (the positive control).
+fn contrasts_matched<const W: usize, const D: usize>(
+    name: &str,
+    cases: &[&Fixture<W>],
+    bounds: &Bounds<W, D>,
+    repeats: usize,
+) {
+    let inject_ns: u128 = std::env::var("STAGE2C_INJECT_NS")
+        .map(|v| v.parse().expect("STAGE2C_INJECT_NS"))
+        .unwrap_or(0);
+    let inject_index: Option<usize> = std::env::var("STAGE2C_INJECT_INDEX")
+        .ok()
+        .map(|v| v.parse().expect("STAGE2C_INJECT_INDEX"));
+    let reference = cases[REFERENCE_INDEX];
+    for case in cases {
+        black_box(time_reduction_matched(case, bounds, Schedule::Reviewed, 0));
+    }
+    for index in REFERENCE_INDEX + 1..=cases.len() {
+        let other = cases[if index == cases.len() { REFERENCE_INDEX } else { index }];
+        let delay = if inject_index == Some(index) { inject_ns } else { 0 };
+        for repeat in 0..repeats {
+            let reference_first = reference_runs_first(repeat);
+            let (reference_ns, other_ns) = if reference_first {
+                let r = time_reduction_matched(reference, bounds, Schedule::Reviewed, 0);
+                (r, time_reduction_matched(other, bounds, Schedule::Reviewed, delay))
+            } else {
+                let o = time_reduction_matched(other, bounds, Schedule::Reviewed, delay);
+                (time_reduction_matched(reference, bounds, Schedule::Reviewed, 0), o)
+            };
+            println!(
+                "matched,{name},{},{},{index},{repeat},{reference_first},{reference_ns},{other_ns}",
+                reference.class.token(),
+                Schedule::Reviewed.token(),
+            );
+        }
+    }
+}
