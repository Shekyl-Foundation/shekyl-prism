+/// Research harness (exp/g7-rule-v2).
+///
+/// One measurement's inputs, held apart from the fixtures.
+#[derive(Clone)]
+struct Datum<const W: usize> {
+    t: Scalar<W>,
+    u: Vector<W>,
+    v: Vector<W>,
+}
+
+/// An arm of the v2 experiment. `Fixture(i)` is the i-th generic fixture by
+/// its original index; the others are copies or key arms.
+#[derive(Clone, Copy, PartialEq)]
+enum Arm {
+    Fixture(usize),
+    Null,
+    InjLow,
+    InjMid,
+    InjHigh,
+    KeyFixed,
+    KeyRandom,
+}
+
+impl Arm {
+    fn token(self) -> String {
+        match self {
+            Self::Fixture(i) => format!("f{i}"),
+            Self::Null => "null".into(),
+            Self::InjLow => "injL".into(),
+            Self::InjMid => "injM".into(),
+            Self::InjHigh => "injH".into(),
+            Self::KeyFixed => "kfix".into(),
+            Self::KeyRandom => "krand".into(),
+        }
+    }
+}
+
+fn inject_for(arm: Arm, phase: Phase) -> u128 {
+    let level = match arm {
+        Arm::InjLow => 0,
+        Arm::InjMid => 1,
+        Arm::InjHigh => 2,
+        _ => return 0,
+    };
+    match phase {
+        Phase::Full => [1600, 3200, 6400][level],
+        _ => [100, 200, 400][level],
+    }
+}
+
+/// One phase on the data in `slot`. Every arm goes through this same code: the
+/// datum is first written into the one persistent buffer `slot`, one untimed
+/// run on a clone of it warms the path, a second clone is taken, then the
+/// timed run. `inject_ns` busy-waits inside the timed interval.
+fn time_cell_v2<const W: usize, const D: usize>(
+    phase: Phase,
+    slot: &mut Datum<W>,
+    datum: &Datum<W>,
+    class: Class,
+    bounds: &Bounds<W, D>,
+    inject_ns: u128,
+) -> u128 {
+    slot.t = datum.t.clone();
+    slot.u = datum.u.clone();
+    slot.v = datum.v.clone();
+    black_box(&*slot);
+    black_box(phase_once(phase, slot, class, bounds, 0));
+    phase_once(phase, slot, class, bounds, inject_ns)
+}
+
+fn phase_once<const W: usize, const D: usize>(
+    phase: Phase,
+    slot: &Datum<W>,
+    class: Class,
+    bounds: &Bounds<W, D>,
+    inject_ns: u128,
+) -> u128 {
+    let schedule = Schedule::Reviewed;
+    let spin = |started: &Instant| {
+        if inject_ns > 0 {
+            while started.elapsed().as_nanos() < inject_ns {
+                std::hint::spin_loop();
+            }
+        }
+    };
+    match phase {
+        Phase::Herm => {
+            let wide_u = black_box(slot.u.each_ref().map(Scalar::resize::<D>));
+            let wide_v = black_box(slot.v.each_ref().map(Scalar::resize::<D>));
+            let started = Instant::now();
+            let p = bounds.prime();
+            drop(black_box((
+                ideal::geometry::hermitian(&wide_u, &wide_u, p),
+                ideal::geometry::hermitian(&wide_v, &wide_v, p),
+                ideal::geometry::hermitian(&wide_v, &wide_u, p),
+            )));
+            drop(wide_u);
+            drop(wide_v);
+            spin(&started);
+            started.elapsed().as_nanos()
+        }
+        _ => {
+            let input = black_box((slot.t.clone(), slot.u.clone(), slot.v.clone()));
+            let started = Instant::now();
+            let (norm, u, v) = input;
+            let basis = Basis::from_intersection(&norm, u, v, class, bounds);
+            if matches!(phase, Phase::Full) {
+                drop(black_box(basis.reduce(schedule)));
+            } else {
+                drop(black_box(basis));
+            }
+            drop(norm);
+            spin(&started);
+            started.elapsed().as_nanos()
+        }
+    }
+}
+
+fn parse_key<const W: usize>(line: &str) -> Datum<W> {
+    let mut f = line.split_whitespace();
+    let n: Scalar<W> = scalar(f.next().unwrap());
+    let root = [scalar(f.next().unwrap()), scalar(f.next().unwrap())];
+    let (u, v) = ideal::GenericHnf::from_norm_and_root(&n, &root).generators();
+    Datum { t: n, u, v }
+}
+
+fn datum_of<const W: usize>(case: &Fixture<W>) -> Datum<W> {
+    Datum {
+        t: case.t.clone(),
+        u: case.u.clone(),
+        v: case.v.clone(),
+    }
+}
+
+/// Shuffled rounds over arms x phases. Rows:
+/// `v2,set,class,arm,phase,round,position,ns`, preceded by one
+/// `v2meta,...` line with the seed, the fixture permutation, the layout pad,
+/// the reference fixture and the slot address.
+fn v2_rounds<const W: usize, const D: usize>(
+    name: &str,
+    cases: &[&Fixture<W>],
+    bounds: &Bounds<W, D>,
+    corpus: &str,
+    rounds: usize,
+    seed: u64,
+) {
+    let class = cases[0].class;
+    let mut rng = Shuffle(seed | 1);
+    // Layout jitter: a seeded padding allocation shifts everything allocated later.
+    let pad = (rng.next() % 8192) as usize;
+    let _pad = std::mem::ManuallyDrop::new(black_box(vec![0u8; pad]));
+    // Per-process fixture order; the first element is this process's reference.
+    let mut perm: Vec<usize> = (0..cases.len()).collect();
+    rng.shuffle(&mut perm);
+    let reference = perm[0];
+    let pool_path = std::env::var("STAGE2C_KEYPOOL").expect("STAGE2C_KEYPOOL");
+    let pool_text = std::fs::read_to_string(&pool_path).expect("key pool");
+    let pool: Vec<Datum<W>> = pool_text.lines().map(parse_key::<W>).collect();
+    let fixed_key = parse_key::<W>(corpus.lines().next().unwrap());
+    if let Ok(n) = std::env::var("STAGE2C_CHECKPOOL") {
+        let n: usize = n.parse().expect("STAGE2C_CHECKPOOL");
+        let mut ok = 0;
+        for key in pool.iter().take(n) {
+            let r = Basis::from_intersection(&key.t, key.u.clone(), key.v.clone(), class, bounds)
+                .reduce(Schedule::Reviewed);
+            ok += usize::from(
+                r.u.iter().chain(&r.v).chain(&r.form).all(|x| x.declassify().is_ok()),
+            );
+        }
+        let fixed = {
+            let k = parse_key::<W>(corpus.lines().next().unwrap());
+            let r = Basis::from_intersection(&k.t, k.u, k.v, class, bounds).reduce(Schedule::Reviewed);
+            r.u.iter().chain(&r.v).chain(&r.form).all(|x| x.declassify().is_ok())
+        };
+        let fix: Vec<bool> = cases
+            .iter()
+            .map(|c| {
+                let r = Basis::from_intersection(&c.t, c.u.clone(), c.v.clone(), class, bounds)
+                    .reduce(Schedule::Reviewed);
+                r.u.iter().chain(&r.v).chain(&r.form).all(|x| x.declassify().is_ok())
+            })
+            .collect();
+        println!("v2check,pool_ok={ok}/{n},corpus_key_ok={fixed},fixtures_ok={fix:?}");
+        return;
+    }
+    let ref_datum = datum_of(cases[reference]);
+    let mut arms: Vec<(Arm, Datum<W>)> = perm
+        .iter()
+        .map(|&i| (Arm::Fixture(i), datum_of(cases[i])))
+        .collect();
+    for arm in [Arm::Null, Arm::InjLow, Arm::InjMid, Arm::InjHigh] {
+        arms.push((arm, ref_datum.clone()));
+    }
+    arms.push((Arm::KeyFixed, fixed_key));
+    arms.push((Arm::KeyRandom, pool[0].clone()));
+    let mut slot = Box::new(ref_datum.clone());
+    println!(
+        "v2meta,{name},seed={seed},pad={pad},perm={},reference=f{reference},pool={},slot=0x{:x}",
+        perm.iter().map(|i| i.to_string()).collect::<Vec<_>>().join("-"),
+        pool.len(),
+        &*slot as *const Datum<W> as usize
+    );
+    let phases = [Phase::Adm, Phase::Herm, Phase::Full];
+    let mut cells: Vec<(usize, Phase)> = (0..arms.len())
+        .flat_map(|a| phases.into_iter().map(move |p| (a, p)))
+        .collect();
+    for (a, (_, d)) in arms.iter().enumerate() {
+        for p in phases {
+            let _ = a;
+            black_box(time_cell_v2(p, &mut slot, d, class, bounds, 0));
+        }
+    }
+    for round in 0..rounds {
+        rng.shuffle(&mut cells);
+        for (position, &(a, phase)) in cells.iter().enumerate() {
+            let arm = arms[a].0;
+            let ns = if arm == Arm::KeyRandom {
+                // A fresh random admitted key per measurement, chosen and copied
+                // outside the timed region (the copy into `slot` is untimed).
+                let key = &pool[(rng.next() % pool.len() as u64) as usize];
+                time_cell_v2(phase, &mut slot, key, class, bounds, 0)
+            } else {
+                time_cell_v2(phase, &mut slot, &arms[a].1, class, bounds, inject_for(arm, phase))
+            };
+            println!(
+                "v2,{name},{},{},{},{round},{position},{ns}",
+                class.token(),
+                arm.token(),
+                phase.token()
+            );
+        }
+    }
+}
