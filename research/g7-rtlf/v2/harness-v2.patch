+/// Research harness: phases of the `time_reduction` interval, measured apart.
+///
+/// `adm` is `Basis::from_intersection` and its drop. `red` is `reduce` and the
+/// drop of its result, on a basis admitted before the clock starts. `full` is
+/// `time_reduction`. `inv` is `geometry::inverse_odd` on the norm. `herm` is the
+/// three guarded Hermitian products that admission divides by the norm. `nop`
+/// is an empty interval, the timer's own cost.
+#[derive(Clone, Copy)]
+enum Phase {
+    Adm,
+    Red,
+    Full,
+    Inv,
+    Herm,
+    Nop,
+}
+
+const PHASES: [Phase; 6] = [
+    Phase::Adm,
+    Phase::Red,
+    Phase::Full,
+    Phase::Inv,
+    Phase::Herm,
+    Phase::Nop,
+];
+
+impl Phase {
+    const fn token(self) -> &'static str {
+        match self {
+            Self::Adm => "adm",
+            Self::Red => "red",
+            Self::Full => "full",
+            Self::Inv => "inv",
+            Self::Herm => "herm",
+            Self::Nop => "nop",
+        }
+    }
+}
+
+fn time_phase<const W: usize, const D: usize>(
+    phase: Phase,
+    case: &Fixture<W>,
+    bounds: &Bounds<W, D>,
+) -> u128 {
+    let schedule = Schedule::Reviewed;
+    match phase {
+        Phase::Full => time_reduction(case, bounds, schedule),
+        Phase::Adm => {
+            let input = black_box((case.t.clone(), case.u.clone(), case.v.clone()));
+            let started = Instant::now();
+            let (norm, u, v) = input;
+            drop(black_box(Basis::from_intersection(
+                &norm, u, v, case.class, bounds,
+            )));
+            drop(norm);
+            started.elapsed().as_nanos()
+        }
+        Phase::Red => {
+            let basis = black_box(Basis::from_intersection(
+                &case.t,
+                case.u.clone(),
+                case.v.clone(),
+                case.class,
+                bounds,
+            ));
+            let started = Instant::now();
+            drop(black_box(basis.reduce(schedule)));
+            started.elapsed().as_nanos()
+        }
+        Phase::Inv => {
+            let t = black_box(case.t.clone());
+            let started = Instant::now();
+            drop(black_box(ideal::geometry::inverse_odd(&t)));
+            drop(t);
+            started.elapsed().as_nanos()
+        }
+        Phase::Herm => {
+            let wide_u = black_box(case.u.each_ref().map(Scalar::resize::<D>));
+            let wide_v = black_box(case.v.each_ref().map(Scalar::resize::<D>));
+            let started = Instant::now();
+            let p = bounds.prime();
+            drop(black_box((
+                ideal::geometry::hermitian(&wide_u, &wide_u, p),
+                ideal::geometry::hermitian(&wide_v, &wide_v, p),
+                ideal::geometry::hermitian(&wide_v, &wide_u, p),
+            )));
+            drop(wide_u);
+            drop(wide_v);
+            started.elapsed().as_nanos()
+        }
+        Phase::Nop => {
+            let started = Instant::now();
+            black_box(());
+            started.elapsed().as_nanos()
+        }
+    }
+}
+
+/// xorshift64*; the harness only needs a reproducible shuffle.
+struct Shuffle(u64);
+
+impl Shuffle {
+    fn next(&mut self) -> u64 {
+        self.0 ^= self.0 >> 12;
+        self.0 ^= self.0 << 25;
+        self.0 ^= self.0 >> 27;
+        self.0.wrapping_mul(0x2545_F491_4F6C_DD1D)
+    }
+
+    fn shuffle<T>(&mut self, items: &mut [T]) {
+        for i in (1..items.len()).rev() {
+            let j = (self.next() % (i as u64 + 1)) as usize;
+            items.swap(i, j);
+        }
+    }
+}
+
+/// One round times every (fixture, phase) cell once, in a fresh random order.
+/// Fixture index `cases.len()` is a second copy of the reference row, so the
+/// harness carries its own null contrast. Rows:
+/// `split,set,class,fixture,phase,round,position,ns`.
+fn split_rounds<const W: usize, const D: usize>(
+    name: &str,
+    cases: &[&Fixture<W>],
+    bounds: &Bounds<W, D>,
+    rounds: usize,
+    seed: u64,
+) {
+    let mut rng = Shuffle(seed | 1);
+    for case in cases {
+        for phase in PHASES {
+            black_box(time_phase(phase, case, bounds));
+        }
+    }
+    let mut cells: Vec<(usize, Phase)> = (0..=cases.len())
+        .flat_map(|f| PHASES.into_iter().map(move |p| (f, p)))
+        .collect();
+    for round in 0..rounds {
+        rng.shuffle(&mut cells);
+        for (position, &(fixture, phase)) in cells.iter().enumerate() {
+            let case = cases[if fixture == cases.len() { REFERENCE_INDEX } else { fixture }];
+            let ns = time_phase(phase, case, bounds);
+            println!(
+                "split,{name},{},{fixture},{},{round},{position},{ns}",
+                case.class.token(),
+                phase.token()
+            );
+        }
+    }
+}
