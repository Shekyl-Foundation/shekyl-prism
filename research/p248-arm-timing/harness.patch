+/// Research harness: phases of the `time_reduction` interval, measured apart.
+///
+/// `adm` is `Basis::from_intersection` and its drop. `red` is `reduce` and the
+/// drop of its result, on a basis admitted before the clock starts. `full` is
+/// `time_reduction`. `inv` is `geometry::inverse_odd` on the norm. `herm` is the
+/// three guarded Hermitian products that admission divides by the norm. `nop`
+/// is an empty interval, the timer's own cost.
+#[derive(Clone, Copy)]
+enum Phase {
+    Adm,
+    Red,
+    Full,
+    Inv,
+    Herm,
+    Nop,
+}
+
+const PHASES: [Phase; 6] = [
+    Phase::Adm,
+    Phase::Red,
+    Phase::Full,
+    Phase::Inv,
+    Phase::Herm,
+    Phase::Nop,
+];
+
+impl Phase {
+    const fn token(self) -> &'static str {
+        match self {
+            Self::Adm => "adm",
+            Self::Red => "red",
+            Self::Full => "full",
+            Self::Inv => "inv",
+            Self::Herm => "herm",
+            Self::Nop => "nop",
+        }
+    }
+}
+
+fn time_phase<const W: usize, const D: usize>(
+    phase: Phase,
+    case: &Fixture<W>,
+    bounds: &Bounds<W, D>,
+) -> u128 {
+    let schedule = Schedule::Reviewed;
+    match phase {
+        Phase::Full => time_reduction(case, bounds, schedule),
+        Phase::Adm => {
+            let input = black_box((case.t.clone(), case.u.clone(), case.v.clone()));
+            let started = Instant::now();
+            let (norm, u, v) = input;
+            drop(black_box(Basis::from_intersection(
+                &norm, u, v, case.class, bounds,
+            )));
+            drop(norm);
+            started.elapsed().as_nanos()
+        }
+        Phase::Red => {
+            let basis = black_box(Basis::from_intersection(
+                &case.t,
+                case.u.clone(),
+                case.v.clone(),
+                case.class,
+                bounds,
+            ));
+            let started = Instant::now();
+            drop(black_box(basis.reduce(schedule)));
+            started.elapsed().as_nanos()
+        }
+        Phase::Inv => {
+            let t = black_box(case.t.clone());
+            let started = Instant::now();
+            drop(black_box(ideal::geometry::inverse_odd(&t)));
+            drop(t);
+            started.elapsed().as_nanos()
+        }
+        Phase::Herm => {
+            let wide_u = black_box(case.u.each_ref().map(Scalar::resize::<D>));
+            let wide_v = black_box(case.v.each_ref().map(Scalar::resize::<D>));
+            let started = Instant::now();
+            let p = bounds.prime();
+            drop(black_box((
+                ideal::geometry::hermitian(&wide_u, &wide_u, p),
+                ideal::geometry::hermitian(&wide_v, &wide_v, p),
+                ideal::geometry::hermitian(&wide_v, &wide_u, p),
+            )));
+            drop(wide_u);
+            drop(wide_v);
+            started.elapsed().as_nanos()
+        }
+        Phase::Nop => {
+            let started = Instant::now();
+            black_box(());
+            started.elapsed().as_nanos()
+        }
+    }
+}
