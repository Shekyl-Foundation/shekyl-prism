+/// One round times every (fixture, phase) cell once, in a fresh random order.
+/// Fixture index `cases.len()` is a second copy of the reference row, so the
+/// harness carries its own null contrast. Rows:
+/// `split,set,class,fixture,phase,round,position,ns`.
+fn split_rounds<const W: usize, const D: usize>(
+    name: &str,
+    cases: &[&Fixture<W>],
+    bounds: &Bounds<W, D>,
+    rounds: usize,
+    seed: u64,
+) {
+    let mut rng = Shuffle(seed | 1);
+    for case in cases {
+        for phase in PHASES {
+            black_box(time_phase(phase, case, bounds));
+        }
+    }
+    let mut cells: Vec<(usize, Phase)> = (0..=cases.len())
+        .flat_map(|f| PHASES.into_iter().map(move |p| (f, p)))
+        .collect();
+    for round in 0..rounds {
+        rng.shuffle(&mut cells);
+        for (position, &(fixture, phase)) in cells.iter().enumerate() {
+            let case = cases[if fixture == cases.len() { REFERENCE_INDEX } else { fixture }];
+            let ns = time_phase(phase, case, bounds);
+            println!(
+                "split,{name},{},{fixture},{},{round},{position},{ns}",
+                case.class.token(),
+                phase.token()
+            );
+        }
+    }
+}
