+/* ibz-trace: the recorder. One row per (operation, output, return address):
+ * the largest bit length written and the number of calls. Written at exit
+ * to the file IBZ_TRACE_OUT names, appended, so that many runs of one
+ * binary can be merged; addresses are resolved afterwards with addr2line,
+ * so the binary is linked without PIE. */
+#include <signal.h>
+#include <stdlib.h>
+#include <unistd.h>
+#define IBZ_TRACE_SLOTS 16384
+static struct {
+    const char *op;
+    void *site;
+    unsigned long bits;
+    unsigned long calls;
+} ibz_trace_rows[IBZ_TRACE_SLOTS];
+static int ibz_trace_registered = 0;
+
+static void
+ibz_trace_dump(void)
+{
+    const char *path = getenv("IBZ_TRACE_OUT");
+    if (path == NULL)
+        return;
+    FILE *out = fopen(path, "a");
+    if (out == NULL)
+        return;
+    for (int i = 0; i < IBZ_TRACE_SLOTS; i++) {
+        if (ibz_trace_rows[i].op != NULL)
+            fprintf(out,
+                    "%s %p %lu %lu\n",
+                    ibz_trace_rows[i].op,
+                    ibz_trace_rows[i].site,
+                    ibz_trace_rows[i].bits,
+                    ibz_trace_rows[i].calls);
+    }
+    fclose(out);
+}
+
+/* The pinned reference divides by zero on some inputs and has loops with
+ * no cap. A run that dies of a signal, or is ended by the driver's
+ * SIGTERM, still writes what it recorded. */
+static void
+ibz_trace_signal(int number)
+{
+    ibz_trace_dump();
+    _exit(128 + number);
+}
+
+void
+ibz_trace_record(const char *op, void *site, const __mpz_struct *value)
+{
+    if (!ibz_trace_registered) {
+        ibz_trace_registered = 1;
+        atexit(ibz_trace_dump);
+        signal(SIGFPE, ibz_trace_signal);
+        signal(SIGABRT, ibz_trace_signal);
+        signal(SIGSEGV, ibz_trace_signal);
+        signal(SIGTERM, ibz_trace_signal);
+    }
+    unsigned long bits = value->_mp_size == 0 ? 0 : (unsigned long)mpz_sizeinbase(value, 2);
+    size_t slot = (((size_t)site >> 2) * 31 + (size_t)op) % IBZ_TRACE_SLOTS;
+    for (int probe = 0; probe < IBZ_TRACE_SLOTS; probe++) {
+        if (ibz_trace_rows[slot].op == NULL) {
+            ibz_trace_rows[slot].op = op;
+            ibz_trace_rows[slot].site = site;
+        }
+        if (ibz_trace_rows[slot].op == op && ibz_trace_rows[slot].site == site) {
+            if (bits > ibz_trace_rows[slot].bits)
+                ibz_trace_rows[slot].bits = bits;
+            ibz_trace_rows[slot].calls++;
+            return;
+        }
+        slot = (slot + 1) % IBZ_TRACE_SLOTS;
+    }
+    fprintf(stderr, "ibz-trace: table full\n");
+    abort();
+}
